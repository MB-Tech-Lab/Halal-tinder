{
  "name": "@halal-tinder/api",
  "version": "0.1.0",
  "description": "Fastify REST API backend for Halal Tinder",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "type-check": "tsc --noEmit",
    "lint": "eslint . --ext .ts",
    "clean": "rm -rf dist .turbo",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "fastify": "^4.25.0",
    "@fastify/cors": "^9.0.0",
    "@fastify/jwt": "^7.8.0",
    "@fastify/multipart": "^8.1.0",
    "@fastify/helmet": "^11.1.1",
    "@fastify/rate-limit": "^9.1.0",
    "@prisma/client": "^5.7.0",
    "prisma": "^5.7.0",
    "redis": "^4.6.0",
    "bullmq": "^5.5.0",
    "zod": "^3.22.4",
    "bcrypt": "^5.1.0",
    "socket.io": "^4.7.0",
    "dotenv": "^16.3.0",
    "@halal-tinder/shared": "*",
    "@halal-tinder/validation": "*",
    "@halal-tinder/config": "*"
  },
  "devDependencies": {
    "typescript": "^5.6.2",
    "tsx": "^4.7.0",
    "nodemon": "^3.0.0",
    "@types/node": "^20.10.0",
    "@types/bcrypt": "^5.0.0",
    "eslint": "^8.52.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0"
  }
}
