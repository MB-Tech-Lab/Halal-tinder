{
  "name": "@halal-tinder/mobile",
  "version": "0.1.0",
  "description": "React Native Expo mobile app for Halal Tinder",
  "private": true,
  "main": "index.js",
  "scripts": {
    "dev": "expo start",
    "build": "expo build",
    "build:web": "expo export --platform web",
